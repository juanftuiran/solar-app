# Configuración de Supabase (obligatorio en producción y desarrollo)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Configuración de la aplicación
VITE_APP_NAME=JF Solar Cloud
VITE_APP_VERSION=4.0.0
VITE_API_TIMEOUT=5000

# Idioma por defecto
VITE_DEFAULT_LANG=es

# Solarman PV Open API v1.0 (SOLO servidor — nunca usar prefijo VITE_)
SOLARMAN_APP_ID=your_solarman_app_id
SOLARMAN_APP_SECRET=your_solarman_app_secret

# Proxy /api/solarman (opcional en producción para restringir CORS y validar JWT)
# ALLOWED_ORIGIN=https://tu-dominio.vercel.app
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
